{# Showcase #}
<section class="block block--dark block--skewed-right block-showcase" id="process">
    <header class="block__header">
        <h2>From Idea to Launch</h2>
    </header>

    <div class="container grid grid--1x2">
        <picture class="block-showcase__image" data-aos="fade-right">
            <source type="image/webp" srcset="/assets/images/ipad.webp 1x, /assets/images/ipad@2x.webp 2x">
            <source type="image/png" srcset="/assets/images/ipad.png 1x, /assets/images/ipad@2x.png 2x">
            <img src="/assets/images/ipad.png" alt="">
        </picture>
        <ul class="list" data-aos="fade-up">
            <li>
                <div class="media">
                    <div class="media__image">
                        <svg class="icon icon--primary">
                            <use xlink:href="/assets/images/icons/sprite.svg#computer"></use>
                        </svg>
                    </div>
                    <div class="media__body">
                        <h3 class="media__title">Discovery</h3>
                        <p>
                            We start by understanding your business goals, target users, and technical landscape. This ensures we build the right solution, not just any solution.
                        </p>
                    </div>
                </div>
            </li>
            <li>
                <div class="media">
                    <div class="media__image">
                        <svg class="icon icon--primary">
                            <use xlink:href="/assets/images/icons/sprite.svg#growth"></use>
                        </svg>
                    </div>
                    <div class="media__body">
                        <h3 class="media__title">Planning</h3>
                        <p>
                            Together, we define the project scope, architecture, timeline, and milestones. You'll know exactly what to expect and when to expect it.
                        </p>
                    </div>
                </div>
            </li>
            <li>
                <div class="media">
                    <div class="media__image">
                        <svg class="icon icon--primary">
                            <use xlink:href="/assets/images/icons/sprite.svg#easy"></use>
                        </svg>
                    </div>
                    <div class="media__body">
                        <h3 class="media__title">Build</h3>
                        <p>
                            We develop your solution iteratively, sharing progress regularly — you'll see working software early and often, with opportunities to refine direction along the way.
                        </p>
                    </div>
                </div>
            </li>
            <li>
                <div class="media">
                    <div class="media__image">
                        <svg class="icon icon--primary">
                            <use xlink:href="/assets/images/icons/sprite.svg#clock"></use>
                        </svg>
                    </div>
                    <div class="media__body">
                        <h3 class="media__title">Launch & Support</h3>
                        <p>
                            We deploy your project, ensure everything runs smoothly, and provide ongoing support to keep your software growing with your business.
                        </p>
                    </div>
                </div>
            </li>
        </ul>
    </div>
</section>