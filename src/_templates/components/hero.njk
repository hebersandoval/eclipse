{# Hero #}
<section class="block block--dark block--skewed-left hero">
    <div class="container grid grid--1x2">
        <header class="block__header hero__content">
            <h1 class="block__heading" data-aos="fade-right">Your Vision, Engineered</h1>
            <p class="hero__tagline">Custom software and web development for startups, small businesses, and entrepreneurs who need expert execution without the hiring headache.</p>
            <div class="hero__actions">
                <a href="/contact" class="btn btn--accent btn--stretched">Let's Talk</a>
                <a href="/#process" class="btn btn--outline btn--stretched">View Process</a>
            </div>
        </header>

        <picture data-aos="zoom-in">
            <source type="image/webp" srcset="/assets/images/banner.webp 1x, /assets/images/banner@2x.webp 2x">
            <source type="image/png" srcset="/assets/images/banner.png 1x, /assets/images/banner@2x.png 2x">
            <img class="hero__image" src="/assets/images/banner.png" alt="" aria-hidden="true" loading="lazy">
        </picture>
    </div>
</section>