{# Plan block #}
<section class="block container block-plans" id="pricing" data-aos="fade-up">
    <header class="block__header">
        <h2>How We Work Together</h2>
        <p>Flexible engagement models designed to match your project scope and business needs.</p>
    </header>
    <div class="grid grid--1x3">
        <div class="plan">
            <div class="card card--secondary">
                <header class="card__header">
                    <h3 class="plan__name">Fixed-Price Projects</h3>
                    <span class="plan__description">Defined scope, clear timeline, predictable investment. Perfect for landing pages, MVPs, and specific feature builds.</span>
                </header>
                <div class="card__body">
                    <ul class="list list--tick">
                        <li class="list__item">Custom-designed responsive website</li>
                        <li class="list__item">Up to 5 pages</li>
                        <li class="list__item">Basic SEO setup</li>
                        <li class="list__item">30-day post-launch support</li>
                    </ul>
                    <a href="/contact" class="btn btn--outline btn--block">Discuss This Model</a>
                </div>
            </div>
        </div>

        <div class="plan">
            <div class="card card--secondary">
                <header class="card__header">
                    <h3 class="plan__name">Hourly Consulting</h3>
                    <span class="plan__description">Flexible support for ongoing development, code reviews, technical guidance, or sprint-based work.</span>
                </header>
                <div class="card__body">
                    <ul class="list list--tick">
                        <li class="list__item">Flexible hours as needed</li>
                        <li class="list__item">Code reviews & architecture</li>
                        <li class="list__item">Bug fixes & optimizations</li>
                        <li class="list__item">Technical guidance & mentoring</li>
                    </ul>
                    <a href="/contact" class="btn btn--outline btn--block">Discuss This Model</a>
                </div>
            </div>
        </div>

        <div class="plan">
            <div class="card card--secondary">
                <header class="card__header">
                    <h3 class="plan__name">Retainer Partnerships</h3>
                    <span class="plan__description">Dedicated development capacity for continuous iteration, growth, and long-term product evolution.</span>
                </header>
                <div class="card__body">
                    <ul class="list list--tick">
                        <li class="list__item">Priority development access</li>
                        <li class="list__item">Continuous iteration & updates</li>
                        <li class="list__item">Technical consulting & architecture</li>
                        <li class="list__item">Priority support & maintenance</li>
                    </ul>
                    <a href="/contact" class="btn btn--outline btn--block">Discuss This Model</a>
                </div>
            </div>
        </div>
    </div>
</section>