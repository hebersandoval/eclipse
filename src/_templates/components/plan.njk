{# Plan block #}
<section class="block container block-plans" id="pricing" data-aos="fade-up">
    <header class="block__header">
        <h2>How We Work Together</h2>
        <p>Flexible engagement options designed to match your project scope and business needs.</p>
    </header>
    <div class="grid grid--1x3">
        <div class="plan">
            <div class="card card--secondary">
                <header class="card__header">
                    <h3 class="plan__name">Launch</h3>
                    <span class="plan__price-label">Starting at</span>
                    <span class="plan__price">$500</span>
                    <span class="plan__description">Perfect for landing pages, simple websites, and MVPs to validate your idea.</span>
                </header>
                <div class="card__body">
                    <ul class="list list--tick">
                        <li class="list__item">Custom-designed responsive website</li>
                        <li class="list__item">Up to 5 pages</li>
                        <li class="list__item">Basic SEO setup</li>
                        <li class="list__item">NEEDS INPUT post-launch support</li>
                    </ul>
                    <a href="/contact" class="btn btn--outline btn--block">Get Started</a>
                </div>
            </div>
        </div>

        <div class="plan plan--popular">
            <div class="card card--primary">
                <header class="card__header">
                    <h3 class="plan__name">Build</h3>
                    <span class="plan__price-label">Starting at</span>
                    <span class="plan__price">$1500</span>
                    <span class="badge badge--primary badge--small">Most Popular</span>
                    <span class="plan__description">Full-featured websites and web applications built to grow with your business.</span>
                </header>
                <div class="card__body">
                    <ul class="list list--tick">
                        <li class="list__item">Everything in Launch, plus:</li>
                        <li class="list__item">Custom functionality & integrations</li>
                        <li class="list__item">Content management system</li>
                        <li class="list__item">Performance optimization</li>
                        <li class="list__item">30-day post-launch support</li>
                    </ul>
                    <a href="/contact" class="btn btn--outline btn--block">Get Started</a>
                </div>
            </div>
        </div>

        <div class="plan">
            <div class="card card--secondary">
                <header class="card__header">
                    <h3 class="plan__name">Scale</h3>
                    <span class="plan__price-label">Starting at</span>
                    <span class="plan__price">$3000</span>
                    <span class="plan__description">Complex systems, ongoing development partnerships, and technical architecture.</span>
                </header>
                <div class="card__body">
                    <ul class="list list--tick">
                        <li class="list__item">Everything in Build, plus:</li>
                        <li class="list__item">Custom API integrations</li>
                        <li class="list__item">Ongoing development & iteration</li>
                        <li class="list__item">Technical consulting & architecture</li>
                        <li class="list__item">Priority support & maintenance</li>
                    </ul>
                    <a href="/contact" class="btn btn--outline btn--block">Get Started</a>
                </div>
            </div>
        </div>
    </div>
</section>